@model IEnumerable<be.Models.delivery>

@{
    ViewData["Title"] = "del_challan";
    Layout = "~/Views/Shared/home.cshtml";
}

<br />
@* <a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="del_challan1">Add Delivery Challan</a>
<br />
 *@
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 style="color:black;">DC# : @ViewBag.id </h2>
            <table class="table table-hover">
            <thead>
                <tr>
                    <th>
                        Product
                    </th>
                    <th>
                        Pack
                    </th>
                    <th>
                        Qty
                    </th>
                    @* <th></th> *@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @{
                            BentContext db = new BentContext();
                            var x = db.Products.Where(x => x.PId == item.p_id).First();
                            <td>@x.PName</td>
                            <td>@x.PPack</td>
                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.qty)
                        </td>
                        @* <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td> *@
                    </tr>
                }
            </tbody>
            </table>
        </div>
    </div>

</div>