
@{
    ViewData["Title"] = "Cheque";
    Layout = "~/Views/Shared/home.cshtml";
}


<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h1 style="color:black;">Apply Aging</h1>
            <br />
            <form asp-controller="filter" asp-action="ag_ss1">
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter From Date</label>
                    <div class="col-sm-9">
                        <input type="date" name="date1" class="form-control" placeholder="Enter Date" required />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter To Date</label>
                    <div class="col-sm-9">
                        <input type="date" name="date2" class="form-control" placeholder="Enter Date" required />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Customer</label>
                    <div class="col-sm-9">
                        <select class="form-control" name="cus" required>
                            <option value="0">--Select--</option>
                            @{
                                BentContext db = new BentContext();
                                var x = db.Customers.ToList();
                                foreach (var item in x)
                                {
                                    <option value="@item.CId">@item.CName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Product</label>
                    <div class="col-sm-9">
                        <select class="form-control" name="pro" required>
                            <option value="0">--Select--</option>
                            @{
                                BentContext db1 = new BentContext();
                                var x1 = db.Products.ToList();
                                foreach (var item in x1)
                                {
                                    <option value="@item.PId">@item.PName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Pack</label>
                    <div class="col-sm-9">
                        <select class="form-control" name="pack" required>
                            <option value="0">Both</option>
                            <option value="Drum">Drum</option>
                            <option value="Pail">Pail</option>
                        </select>
                    </div>
                </div>
                @{
                    if (TempData.ContainsKey("data"))
                    {
                        <span class="text-danger">@TempData["data"]</span>
                    }
                }
                <br />
                <div class="form-group">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
