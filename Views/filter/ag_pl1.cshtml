@model IEnumerable<be.Models.Productledger>

@{
    ViewData["Title"] = "pl";
    Layout = "~/Views/Shared/home.cshtml";
}

<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="ag_pl" asp-route-id="@ViewBag.iid">Aging</a>
<br />
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Product Ledger</h4>
            <table class="table table-hover">
                <h3 style="color:black;">@ViewBag.name</h3>
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Particular
                        </th>
                        <th>
                            In
                        </th>
                        <th>
                            Out
                        </th>
                        <th>
                            Balance
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var bal = 0;
                    }
                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>
                                @item.day-@item.month-@item.year
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlIn)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlOut)
                            </td>
                            @{
                                if (item.PlIn == 0)
                                {
                                    bal = bal - Convert.ToInt32(item.PlOut);
                                }
                                else if (item.PlOut == 0)
                                {
                                    bal = bal + Convert.ToInt32(item.PlIn);
                                }
                            }
                            <td>@bal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>