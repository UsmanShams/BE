@model IEnumerable<be.Models.Secondarysale>

@{
    ViewData["Title"] = "ss";
    Layout = "~/Views/Shared/home.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
<br />
<a class="btn btn-secondary btn-fw" asp-controller="front" asp-action="ss_pending">Pending Delivery</a>
<br />
<br />
<br />
<style>
    .btn-primary.btn-rounded.btn-fw:hover {
        background: #a01a13 !important; /* darker logo red */
        border-color: #a01a13 !important;
        color: #ffffff !important;
    }
</style>

@* <a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="search_ss">Search</a> *@
@* <a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="ag_ss2">Till Date</a> *@
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="ag_ss">Aging</a>
<a class="btn btn-secondary btn-rounded btn-fw" asp-controller="filter" asp-action="ss">Share <i class="fa-solid fa-share-nodes"></i></a>
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Secondary Sales</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>DC #</th>
                        <th>
                            Order #
                        </th>
                        <th>
                            Date
                        </th>
                        <th>
                            Customer
                        </th>
                        <th>
                            Product
                        </th>
                        <th>
                            Qty
                        </th>
                        <th>
                            Pack
                        </th>
                        <th>
                            Total Ltr
                        </th>
                        <th>
                            Price/Ltr
                        </th>
                        <th>
                            Price
                        </th>
                        <th>
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var tqt =0;
                        var tltr = 0;
                        var tpr = 0;
                    }
                    @foreach (var item in Model)
                    {
                        tpr = tpr + Convert.ToInt32(item.SsQty * item.TPrice);
                        tqt = tqt + Convert.ToInt32(item.SsQty);
                        tltr = tltr + Convert.ToInt32(item.Pack) * Convert.ToInt32(item.SsQty);
                        var qtt = Convert.ToInt32(item.Pack) * Convert.ToInt32(item.SsQty);
                        <tr>
                            @{
                                if (item.Status == 0)
                                {
                                    <td>--</td>
                                }
                                else
                                {
                                    <td>@item.Status</td>
                                }
                            }
                            @{
                                if (item.Type == "Drum")
                                {
                                    <td>
                                        @item.SsOrderno
                                    </td>
                                }
                                else if (item.Type == "Druml" || item.Type == "Pail")
                                {
                                    <td>
                                        LBE-@item.SsOrderno
                                    </td>
                                }
                            }
                            @{
                                if (item.Month == 1)
                                {
                                    <td>@item.Day-Jan-@item.Year</td>
                                }
                                else if (item.Month == 2)
                                {
                                    <td>@item.Day-Feb-@item.Year</td>
                                }
                                else if (item.Month == 3)
                                {
                                    <td>@item.Day-Mar-@item.Year</td>
                                }
                                else if (item.Month == 4)
                                {
                                    <td>@item.Day-Apr-@item.Year</td>
                                }
                                else if (item.Month == 5)
                                {
                                    <td>@item.Day-May-@item.Year</td>
                                }
                                else if (item.Month == 6)
                                {
                                    <td>@item.Day-Jun-@item.Year</td>
                                }
                                else if (item.Month == 7)
                                {
                                    <td>@item.Day-Jul-@item.Year</td>
                                }
                                else if (item.Month == 8)
                                {
                                    <td>@item.Day-Aug-@item.Year</td>
                                }
                                else if (item.Month == 9)
                                {
                                    <td>@item.Day-Sep-@item.Year</td>
                                }
                                else if (item.Month == 10)
                                {
                                    <td>@item.Day-Oct-@item.Year</td>
                                }
                                else if (item.Month == 11)
                                {
                                    <td>@item.Day-Nov-@item.Year</td>
                                }
                                else if (item.Month == 12)
                                {
                                    <td>@item.Day-Dec-@item.Year</td>
                                }
                            }
                            @{
                                if (item.CId == 0)
                                {
                                    <td>Bilal Associate</td>
                                }
                                else
                                {
                                        BentContext db = new BentContext();
                                        var x = db.Customers.Where(x=>x.CId == item.CId).First();
                                        <td>@x.CName</td>
                                }
                            }@{

                                BentContext db1 = new BentContext();
                                var x1 = db1.Products.Where(x => x.PId == item.PId).First();
                                <td>@x1.PName</td>
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.SsQty)
                            </td>
                            <td>@item.Pack</td>
                            <td>@qtt</td>
                            <td>@item.Price</td>
                            <td>@item.TPrice</td>
                            <td>
                                <a asp-action="ss" asp-controller="edit" asp-route-id="@item.SsId">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tbody>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>@tqt</td>
                        <td></td>
                        <td>@tltr</td>
                        <td></td>
                        <td>@tpr</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>