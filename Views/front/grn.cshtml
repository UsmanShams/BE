@model IEnumerable<be.Models.Grn>

@{
    ViewData["Title"] = "grn";
    Layout = "~/Views/Shared/home.cshtml";
}

<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">GRN Table</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Purchase Order #
                        </th>
                        <th>
                            Grn Dilevery Challan
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.day-@item.month-@item.year
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Pono)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.GrnDc)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>