@{
    ViewData["Title"] = "signin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bilal Enterprises — Sign In</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --red:#c8281f;
  --red-deep:#a01a13;
  --orange:#e87b18;
  --orange-soft:#f0922e;
  --ink:#1a1614;
  --muted:#7a716c;
  --line:#e7ddd6;
  --field:#faf6f2;
  --paper:#ffffff;
  --bg:#f3ece6;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  font-family:'Manrope',sans-serif;
  background:var(--bg);
  color:var(--ink);
  display:grid;
  place-items:center;
  min-height:100vh;
  padding:24px;
  position:relative;
  overflow-x:hidden;
}
/* atmospheric backdrop echoing the logo arc + dots */
.backdrop{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
.glow{position:absolute;border-radius:50%;filter:blur(70px);opacity:.5}
.glow.a{width:520px;height:520px;background:radial-gradient(circle,#f0922e55,transparent 70%);top:-180px;right:-120px}
.glow.b{width:480px;height:480px;background:radial-gradient(circle,#c8281f3d,transparent 70%);bottom:-200px;left:-140px}
.arc{position:absolute;top:8%;left:50%;transform:translateX(-50%);width:120%;height:auto;opacity:.06}
.dot{position:absolute;border-radius:50%;background:var(--orange);opacity:.18}

.shell{
  position:relative;z-index:2;
  width:100%;max-width:980px;
  background:var(--paper);
  border-radius:26px;
  box-shadow:0 30px 80px -30px rgba(160,26,19,.28), 0 4px 18px rgba(0,0,0,.05);
  display:grid;
  grid-template-columns:1.05fr 1fr;
  overflow:hidden;
  border:1px solid #f0e7e0;
}

/* LEFT: brand panel */
.brand{
  position:relative;
  padding:54px 48px;
  background:
    linear-gradient(155deg,#fff 0%,#fff7f1 55%,#fdeede 100%);
  display:flex;flex-direction:column;
  border-right:1px solid var(--line);
  overflow:hidden;
}
.brand::after{
  content:"";position:absolute;right:-90px;top:-90px;width:240px;height:240px;border-radius:50%;
  background:radial-gradient(circle at 30% 30%,#f0922e22,transparent 70%);
}
.logo-wrap{margin-bottom:auto}
.logo-wrap img{width:100%;max-width:330px;height:auto;display:block}
.tag{
  margin-top:38px;max-width:340px;
}
.tag h2{
  font-family:'Sora',sans-serif;font-weight:800;font-size:1.65rem;line-height:1.18;
  letter-spacing:-.02em;color:var(--ink);
}
.tag h2 span{color:var(--red)}
.tag p{margin-top:14px;color:var(--muted);font-size:.97rem;line-height:1.55}
.pills{display:flex;gap:10px;margin-top:30px;flex-wrap:wrap}
.pill{
  font-size:.74rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;
  color:var(--red-deep);background:#fdecea;border:1px solid #f6d7d2;
  padding:7px 13px;border-radius:999px;
}
.pill.o{color:#b35d09;background:#fdf0e1;border-color:#f6dcbf}

/* RIGHT: form panel */
.form-side{padding:54px 50px;display:flex;flex-direction:column;justify-content:center}
.eyebrow{font-family:'Sora',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--orange)}
.form-side h1{font-family:'Sora',sans-serif;font-size:2rem;font-weight:800;letter-spacing:-.025em;margin-top:10px}
.sub{color:var(--muted);font-size:.95rem;margin-top:8px;margin-bottom:30px}

.field{margin-bottom:18px}
.field label{display:block;font-size:.82rem;font-weight:600;color:#574e49;margin-bottom:8px;letter-spacing:.01em}
.input{position:relative}
.input input{
  width:100%;padding:14px 16px 14px 46px;
  border:1.5px solid var(--line);border-radius:13px;
  background:var(--field);font-family:inherit;font-size:.97rem;color:var(--ink);
  transition:border-color .18s, box-shadow .18s, background .18s;
}
.input input::placeholder{color:#b3a89f}
.input input:focus{
  outline:none;border-color:var(--red);background:#fff;
  box-shadow:0 0 0 4px rgba(200,40,31,.10);
}
.input .ic{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#bba89e;pointer-events:none}
.input input:focus ~ .ic{color:var(--red)}
.toggle{position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#a89a90;font-size:.78rem;font-weight:600;padding:4px 6px}
.toggle:hover{color:var(--red)}

.row{display:flex;align-items:center;justify-content:space-between;margin:6px 0 26px}
.remember{display:flex;align-items:center;gap:9px;font-size:.86rem;color:#574e49;cursor:pointer;user-select:none}
.remember input{appearance:none;width:18px;height:18px;border:1.5px solid #d6cabf;border-radius:5px;cursor:pointer;position:relative;transition:.15s}
.remember input:checked{background:var(--red);border-color:var(--red)}
.remember input:checked::after{content:"";position:absolute;left:5px;top:1.5px;width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.forgot{font-size:.86rem;font-weight:600;color:var(--red);text-decoration:none}
.forgot:hover{text-decoration:underline}

.btn{
  width:100%;padding:15px;border:none;border-radius:13px;cursor:pointer;
  font-family:'Sora',sans-serif;font-weight:700;font-size:1rem;letter-spacing:.01em;color:#fff;
  background:linear-gradient(135deg,var(--red) 0%,var(--red-deep) 60%,#8a1810 100%);
  box-shadow:0 12px 26px -8px rgba(200,40,31,.55);
  transition:transform .14s, box-shadow .14s, filter .14s;
  position:relative;overflow:hidden;
}
.btn::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,transparent,rgba(232,123,24,.35));opacity:0;transition:opacity .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 18px 34px -10px rgba(200,40,31,.6)}
.btn:hover::before{opacity:1}
.btn:active{transform:translateY(0)}

.divider{display:flex;align-items:center;gap:14px;margin:26px 0;color:#b3a89f;font-size:.78rem;font-weight:600;letter-spacing:.06em}
.divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--line)}

.alt{
  width:100%;padding:13px;border:1.5px solid var(--line);border-radius:13px;background:#fff;cursor:pointer;
  font-family:inherit;font-weight:600;font-size:.92rem;color:#4a423d;display:flex;align-items:center;justify-content:center;gap:10px;
  transition:border-color .15s, background .15s;
}
.alt:hover{border-color:#cdbfb4;background:#fdfbf9}

.foot{margin-top:28px;text-align:center;font-size:.9rem;color:var(--muted)}
.foot a{color:var(--red);font-weight:700;text-decoration:none}
.foot a:hover{text-decoration:underline}

/* page-load reveal */
.shell{animation:rise .6s cubic-bezier(.2,.7,.2,1) both}
.form-side > *{animation:fade .5s ease both}
.form-side > *:nth-child(1){animation-delay:.08s}
.form-side > *:nth-child(2){animation-delay:.13s}
.form-side > *:nth-child(3){animation-delay:.18s}
.form-side > *:nth-child(4){animation-delay:.23s}
.form-side > *:nth-child(5){animation-delay:.28s}
.form-side > *:nth-child(6){animation-delay:.33s}
.form-side > *:nth-child(7){animation-delay:.38s}
.form-side > *:nth-child(8){animation-delay:.43s}
@@keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

@@media (max-width:820px){
  .shell{grid-template-columns:1fr;max-width:460px}
  .brand{padding:38px 36px 30px;border-right:none;border-bottom:1px solid var(--line)}
  .logo-wrap img{max-width:240px}
  .tag{display:none}
  .form-side{padding:38px 34px 44px}
}
</style>
</head>
<body>
<div class="backdrop">
  <div class="glow a"></div>
  <div class="glow b"></div>
  <div class="dot" style="width:16px;height:16px;top:14%;left:12%"></div>
  <div class="dot" style="width:24px;height:24px;top:22%;left:80%"></div>
  <div class="dot" style="width:12px;height:12px;top:70%;left:8%"></div>
  <div class="dot" style="width:20px;height:20px;top:78%;left:88%"></div>
</div>

<main class="shell">
  <!-- Brand panel -->
  <section class="brand">
    <div class="logo-wrap">
      <img src="data:image/jpeg;base64," alt="Bilal Enterprises — Distribution Network">
    </div>
    <div class="tag">
      <h2>Powering your <span>distribution</span> network.</h2>
      <p>Sign in to manage orders, track inventory, and oversee your supply chain from a single dashboard.</p>
      <div class="pills">
        <span class="pill">Secure Access</span>
        <span class="pill o">Distribution Portal</span>
      </div>
    </div>
  </section>

  <!-- Form panel -->
  <section class="form-side">
    <div class="eyebrow">Welcome back</div>
    <h1>Sign in to your account</h1>
    <p class="sub">Enter your credentials to access the portal.</p>

            <form asp-controller="front" asp-action="signin">
                <div class="field">
                    <label for="email">Username</label>
                    <div class="input">
                        <input type="text" name="email" id="email" placeholder="you@bilalenterprises.com" autocomplete="username">
                        <svg class="ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                    </div>
                </div>

                <div class="field">
                    <label for="pass">Password</label>
                    <div class="input">
                        <input type="password" name="pass" id="pass" placeholder="Enter your password" autocomplete="current-password">
                        <svg class="ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <button type="button" class="toggle" id="tog">Show</button>
                    </div>
                </div>

                <div class="row">
                    <label class="remember"><input type="checkbox"> Remember me</label>
                    <a class="forgot" href="#">Forgot password?</a>
                </div>

                @{
                    if (TempData.ContainsKey("mess"))
                    {
                        <span class="text-danger">@TempData["mess"]</span>
                    }
                }
                <br />
                <button class="btn" id="signin">Sign In</button>
     </form>

    <div class="divider">OR</div>

    <p class="foot">Need an account? <a href="#">Contact your administrator</a></p>
  </section>
</main>

    <script>
        const tog = document.getElementById('tog'), pass = document.getElementById('pass');
        tog.addEventListener('click', () => { const s = pass.type === 'password'; pass.type = s ? 'text' : 'password'; tog.textContent = s ? 'Hide' : 'Show'; });
        document.getElementById('signin').addEventListener('click', () => {
            const e = document.getElementById('email').value.trim();
            if (!e || !pass.value) { alert('Please enter your credentials.'); return; }
            alert('Signing in… (connect this to your backend)');
        });
        pass.addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('signin').click(); });
</script>
</body>
</html>