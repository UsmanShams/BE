@model IEnumerable<be.Models.Product>

@{
    ViewData["Title"] = "product";
    Layout = "~/Views/Shared/home.cshtml";
}
<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="product">Add Product</a>
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Product Table</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Code
                        </th>
                        <th>
                            Product Name
                        </th>
                        <th>
                            Pack
                        </th>
                        <th>
                            Type
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.PCode)
                            </td>
                            <td>
                                <a asp-action="pl" asp-controller="front" asp-route-id="@item.PId">
                                    @Html.DisplayFor(modelItem => item.PName)
                                </a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PPack)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PType)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>