@model IEnumerable<be.Models.Pay>

@{
    ViewData["Title"] = "payment";
    Layout = "~/Views/Shared/home.cshtml";
}

<style>
    .btn-primary.btn-rounded.btn-fw:hover {
        background: #a01a13 !important; /* darker logo red */
        border-color: #a01a13 !important;
        color: #ffffff !important;
    }
</style>
<style>
    .product-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 2px;
        color: #b91c1c;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
    }

        .product-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 2px;
            background: #b91c1c;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .product-link:hover::after {
            transform: scaleX(1);
        }

        .product-link svg {
            flex-shrink: 0;
        }
</style>
<br />
<div class="container">
    <div class="container">
        <div class="container">
            <a asp-controller="front" asp-action="cheque" class="product-link">
                    Cheque's
            </a>
            <br />
            <br />
            <a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="payment">Add Payment</a>
        </div>
    </div>
</div>

<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 style="color:black;">Online/Cash Payments</h2>
            @{
                if (TempData.ContainsKey("data"))
                {
                    <span class="text-danger">@TempData["data"]</span>
                }
            }
            <table class="table table-hover">
            <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Time)
                        </th>
                        <th>
                            Payer Name
                        </th>
                        <th>
                            Mode
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            Amount
                        </th>
                        <th>
                            Action
                        </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                        <tr>
                            @{
                                if (item.Month == 1)
                                {
                                    <td>@item.Day-Jan-@item.Year</td>
                                }
                                else if (item.Month == 2)
                                {
                                    <td>@item.Day-Feb-@item.Year</td>
                                }
                                else if (item.Month == 3)
                                {
                                    <td>@item.Day-Mar-@item.Year</td>
                                }
                                else if (item.Month == 4)
                                {
                                    <td>@item.Day-Apr-@item.Year</td>
                                }
                                else if (item.Month == 5)
                                {
                                    <td>@item.Day-May-@item.Year</td>
                                }
                                else if (item.Month == 6)
                                {
                                    <td>@item.Day-Jun-@item.Year</td>
                                }
                                else if (item.Month == 7)
                                {
                                    <td>@item.Day-Jul-@item.Year</td>
                                }
                                else if (item.Month == 8)
                                {
                                    <td>@item.Day-Aug-@item.Year</td>
                                }
                                else if (item.Month == 9)
                                {
                                    <td>@item.Day-Sep-@item.Year</td>
                                }
                                else if (item.Month == 10)
                                {
                                    <td>@item.Day-Oct-@item.Year</td>
                                }
                                else if (item.Month == 11)
                                {
                                    <td>@item.Day-Nov-@item.Year</td>
                                }
                                else if (item.Month == 12)
                                {
                                    <td>@item.Day-Dec-@item.Year</td>
                                }
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.Time)
                            </td>
                            @{
                                BentContext db = new BentContext();
                                if(item.Type == "Pet")
                                {
                                    var ven = db.Venders.Where(x => x.VId == item.PayerName).First();
                                    <td>@ven.VName</td>
                                }
                                else
                                {
                                    var cus = db.Customers.Where(x => x.CId == item.PayerName).First();
                                    <td>@cus.CName</td>
                                }
                            }
                            <td>@item.Mode</td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PAmount)
                        </td>
                        <td>
                            <a asp-action="online_pay" asp-controller="edit" asp-route-id="@item.PaId" >Edit</a> |
                            <a asp-action="online_pay" asp-controller="del" asp-route-id="@item.PaId">Delete</a>
                        </td>
                            
                    </tr>
                }
            </tbody>
            </table>
        </div>
    </div>

</div>