@model IEnumerable<be.Models.del_no>

@{
    ViewData["Title"] = "del_challan";
    Layout = "~/Views/Shared/home.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="del_challan1">Add Delivery Challan</a>
<br />
<style>
    .btn-primary.btn-rounded.btn-fw:hover {
        background: #a01a13 !important; /* darker logo red */
        border-color: #a01a13 !important;
        color: #ffffff !important;
    }
</style>
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 style="color:black;">Delivery Challan</h2>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>DC #</th>
                        <th>
                            Customer Name
                        </th>
                        <th>Action</th>

                        <th>Generate DC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            @{
                                if(item.CId != null)
                                {
                                    <td>@item.DId</td>
                                    BentContext db = new BentContext();
                                    var cus = db.Customers.Where(x => x.CId == item.CId).First();
                                    <td>@cus.CName</td>
                                    <td>
                                        <a asp-action="del_challan" asp-controller="det" asp-route-id="@item.DId">Details</a>
                                    </td>
                                    <td>
                                        <a asp-action="del_recipt" asp-controller="det" asp-route-id="@item.DId"><i class="fa-solid fa-print"></i></a>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>