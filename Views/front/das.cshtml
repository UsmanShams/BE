@model IEnumerable<be.Models.Da>

@{
    ViewData["Title"] = "das";
    Layout = "~/Views/Shared/home.cshtml";
}
<style>
    .product-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 2px;
        color: #b91c1c;
        text-decoration:none !important;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
    }

        .product-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 2px;
            background: #b91c1c;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .product-link:hover::after {
            transform: scaleX(1);
        }

        .product-link svg {
            flex-shrink: 0;
        }
</style>
<br />

<div class="container">
    <div class="container">
        <div class="container">
            <a asp-controller="front" asp-action="das_pay" class="product-link">
                Payment
            </a>
        </div>
   </div>
</div>
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 style="color:black;">Product DAS</h2>
            <h4 class="card-title">Daily Activity Sheet (Product)</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Description
                        </th>
                        <th>
                            Expense
                        </th>
                        <th>
                            Credit
                        </th>
                        <th>
                            Debit
                        </th>
                        <th>
                            Balance
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.day-@item.month-@item.year
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasDescrition)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasExpense)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasCredit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasDeit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasBalance)
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
        </div>
    </div>
</div>