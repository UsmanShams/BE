@model IEnumerable<be.Models.Stock>

@{
    ViewData["Title"] = "stock";
    Layout = "~/Views/Shared/home.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
<br />
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Stock</h4>
            <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>
                                Product Name
                            </th>
                            <th>
                                Packaging
                            </th>
                            <th>
                                Qty
                            </th>
                        <th>
                            Total LTR
                        </th>
                        <th>Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                <a asp-action="pl" asp-controller="front" asp-route-id="@item.PId">@Html.DisplayFor(modelItem => item.PName)</a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PPack)
                                </td>
                            @{
                                BentContext db = new BentContext();
                                var plx1 = db.Productledgers.OrderBy(x => x.PlId);
                                var pid1 = 0;
                                foreach (var item1 in plx1)
                                {
                                    if (item1.Pid == item.PId)
                                    {
                                        pid1 = Convert.ToInt32(item1.PlId);
                                    }
                                }
                                var pl121 = db.Productledgers.Any(x => x.PlId == pid1);
                                if(pl121 is true)
                                {
                                    var pl21 = db.Productledgers.Where(x => x.PlId == pid1).First();
                                    var stock = db.Stocks.Where(x => x.SId == item.SId).First();
                                    db.SaveChanges();
                                    <td>
                                        @pl21.PlBalance
                                    </td>
                                }
                                else
                                {
                                    <td>0</td>
                                }
                                var x = item.PPack * item.SQty;
                                <td>@x</td>
                                <td>
                                    <a asp-action="pl" asp-controller="filter" asp-route-id="@item.PId"><i class="fa-solid fa-print"></i></a>
                                </td>
                            }
                            </tr>
                        }
                    </tbody>
                <tbody>
                    <td>Total</td>
                <td></td>
                <td style="font-weight:bold;">@ViewBag.tqt</td>
                <td style="font-weight:bold;">@ViewBag.tltr LTR</td>
                </tbody>
                </table>
        </div>
    </div>
</div>