@{
    if (Context.Session.GetString("role") == "0")
    {
        <script>
            // Redirect to a specific URL after the page loads
            window.location.href = '@Url.Action("dash1", "front")';
        </script>
    }
}
@model IEnumerable<be.Models.User>

@{
    ViewData["Title"] = "user";
    Layout = "~/Views/Shared/home.cshtml";
}
<style>
    .btn-primary.btn-rounded.btn-fw:hover {
        background: #a01a13 !important; /* darker logo red */
        border-color: #a01a13 !important;
        color: #ffffff !important;
    }
</style>
<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="user">Add User</a>
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">User Table</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            User Name
                        </th>
                        <th>
                            Email
                        </th>
                        <th>
                            Phone
                        </th>
                        <th>
                            Role
                        </th>
                        <th>
                            Password
                        </th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.UName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UEmail)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UPhone)
                            </td>
                                @{
                                    if (item.URole == 0){
                                        <td>User</td>
                                    }
                                    else{
                                        <td>Admin</td>
                                    }
                                }
                            <td>
                                @Html.DisplayFor(modelItem => item.Pass)
                            </td>
                            <td>
                                <a asp-action="user" asp-controller="edit" asp-route-id="@item.UId">Edit</a> |
                                <a asp-action="user" asp-controller="del" asp-route-id="@item.UId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>