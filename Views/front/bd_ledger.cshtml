@model IEnumerable<be.Models.BankDetail>

@{
    ViewData["Title"] = "bd_ledger";
    Layout = "~/Views/Shared/home.cshtml";
}
<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="bank_detail" asp-route-id="@ViewBag.id">Add Bank Statement</a>
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">Bank Ledger</h2>
            <h3 style="color:black;">@ViewBag.name</h3>
            <table class="table table-hover">
            <thead>
                <tr>
                    <th>
                        Date
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.time)
                    </th>
                    <th>
                        Sender
                    </th>
                    <th>
                        In
                    </th>
                    <th>
                        Out
                    </th>
                    <th>
                        Balance
                    </th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.day-@item.month-@item.year
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.time)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BdSender)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BdIn)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BdOut)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BdBalance)
                        </td>
                            @{
                                if(item.typ == 0)
                                {
                                    <td>
                                        <a asp-action="bank_detail" asp-controller="edit" asp-route-id="@item.BdId">Edit</a> |
                                        <a asp-action="bank_detail" asp-controller="del" asp-route-id="@item.BdId">Delete</a>
                                    </td>
                                }
                            }
                    </tr>
                }
            </tbody>
            </table>
        </div>
    </div>
</div>