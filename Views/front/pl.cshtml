@model IEnumerable<be.Models.Productledger>

@{
    ViewData["Title"] = "pl";
    Layout = "~/Views/Shared/home.cshtml";
}

<br />
<a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="ag_pl" asp-route-id="@ViewBag.iid">Aging</a>
<br />
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Product Ledger</h4>
            <table class="table table-hover">
                <h3 style="color:black;">@ViewBag.name</h3>
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            PO #
                        </th>
                        <th>
                            Order #
                        </th>
                        <th>
                            loose #
                        </th>
                        <th>
                            Particular
                        </th>
                        <th>
                            In
                        </th>
                        <th>
                            Out
                        </th>
                        <th>
                            Balance
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        
                        <tr>
                            @{
                                if (item.month == "1")
                                {
                                    <td>@item.day-Jan-@item.year</td>
                                }
                                else if (item.month == "2")
                                {
                                    <td>@item.day-Feb-@item.year</td>
                                }
                                else if (item.month == "3")
                                {
                                    <td>@item.day-Mar-@item.year</td>
                                }
                                else if (item.month == "4")
                                {
                                    <td>@item.day-Apr-@item.year</td>
                                }
                                else if (item.month == "5")
                                {
                                    <td>@item.day-May-@item.year</td>
                                }
                                else if (item.month == "6")
                                {
                                    <td>@item.day-Jun-@item.year</td>
                                }
                                else if (item.month == "7")
                                {
                                    <td>@item.day-Jul-@item.year</td>
                                }
                                else if (item.month == "8")
                                {
                                    <td>@item.day-Aug-@item.year</td>
                                }
                                else if (item.month == "9")
                                {
                                    <td>@item.day-Sep-@item.year</td>
                                }
                                else if (item.month == "10")
                                {
                                    <td>@item.day-Oct-@item.year</td>
                                }
                                else if (item.month == "11")
                                {
                                    <td>@item.day-Nov-@item.year</td>
                                }
                                else if (item.month == "12")
                                {
                                    <td>@item.day-Dec-@item.year</td>
                                }
                            }
                            @{
                                if (item.Type == "primary")
                                {
                                    <td>
                                        BE-@item.pono
                                    </td>
                                }
                                else
                                {
                                    <td>--</td>
                                }
                            }
                            @{
                                if (item.Type == "secondary")
                                {
                                    <td>
                                        @item.pono
                                    </td>
                                }
                                else
                                {
                                    <td>--</td>
                                }
                            }
                            @{
                                if (item.Type == "loose")
                                {
                                    <td>
                                        Loose-BE-@item.pono
                                    </td>
                                }
                                else
                                {
                                    <td>--</td>
                                }
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.CName)
                            </td>
                            @if (item.PlIn == 0)
                            {
                                <td>-</td>
                            }
                            else
                            {
                                <td>@item.PlIn</td>
                            }
                            @if (item.PlOut == 0)
                            {
                                <td>-</td>
                            }
                            else
                            {
                                <td>@item.PlOut</td>
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.PlBalance)
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
        </div>
    </div>
</div>