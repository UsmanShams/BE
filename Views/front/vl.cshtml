@model IEnumerable<be.Models.Vender>

@{
    ViewData["Title"] = "vendor";
    Layout = "~/Views/Shared/home.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Vendor Ledger</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Vendor Name
                        </th>
                        <th>Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="vl1" asp-controller="front" asp-route-id="@item.VId">@Html.DisplayFor(modelItem => item.VName)</a>
                            </td>

                            <td>
                                <a asp-action="vl" asp-controller="filter" asp-route-id="@item.VId"><i class="fa-solid fa-print"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>