@model IEnumerable<be.Models.Da>

@{
    ViewData["Title"] = "das";
    Layout = "~/Views/Shared/home.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

<style>
    .btn-primary.btn-rounded.btn-fw:hover {
        background: #a01a13 !important; /* darker logo red */
        border-color: #a01a13 !important;
        color: #ffffff !important;
    }
</style>
<style>
    .product-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 2px;
        color: #b91c1c;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
    }

        .product-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 2px;
            background: #b91c1c;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .product-link:hover::after {
            transform: scaleX(1);
        }

        .product-link svg {
            flex-shrink: 0;
        }
</style>

<br />
<div class="container">
    <div class="container">
        <div class="container">
            <a asp-controller="front" asp-action="das" class="product-link">
                Product
            </a>
            <br />
            <br />
            <a class="btn btn-primary btn-rounded btn-fw" asp-controller="add" asp-action="das">Add DAS</a>
            <a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="ag_das">Aging</a>
            <a class="btn btn-primary btn-rounded btn-fw" asp-controller="filter" asp-action="das">Share <i class="fa-solid fa-share-nodes"></i></a>

        </div>
    </div>
</div>

<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h2 style="color:black;">Payment Das</h2>
            <h4 class="card-title">Daily Activity Sheet (Payment)</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Description
                        </th>
                        <th>
                            Expense
                        </th>
                        <th>
                            Credit
                        </th>
                        <th>
                            Debit
                        </th>
                        <th>
                            Balance
                        </th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.day-@item.month-@item.year
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasDescrition)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasExpense)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasCredit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasDeit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DasBalance)
                            </td>
                            @{
                                if(item.typ1 == "dd")
                                {
                                    <td>
                                        <a asp-action="das" asp-controller="edit" asp-route-id="@item.DasId">Edit</a> |
                                        <a asp-action="das" asp-controller="del" asp-route-id="@item.DasId">Delete</a>
                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>