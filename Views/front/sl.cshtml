@model IEnumerable<be.Models.Productledger>

@{
    ViewData["Title"] = "pl";
    Layout = "~/Views/Shared/home.cshtml";
}


<br />
<br />
<div class="col-lg-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Stock Ledger</h4>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            Date
                        </th>
                        <th>
                            Particular
                        </th>
                        <th>
                            Product
                        </th>
                        <th>
                            In
                        </th>
                        <th>
                            Out
                        </th>
                        <th>
                            Balance
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {

                        <tr>
                            <td>
                                @item.day-@item.month-@item.year
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CName)
                            </td>
                            @{
                                BentContext db = new BentContext();
                                var x = db.Products.Where(x => x.PId == item.Pid).First();
                                <td>@x.PName</td>
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.PlIn)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlOut)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.PlBalance)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>