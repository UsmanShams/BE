@model be.Models.Order


@{
    ViewData["Title"] = "po";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Edit Order</h4>
            <form class="forms-sample" asp-controller="edit" asp-action="order">
                @{
                    if (TempData.ContainsKey("mess"))
                    {
                        <span class="text-danger">@TempData["mess"]</span>
                    }
                }

                <input type="hidden" asp-for="OId" class="form-control" placeholder="Enter Qty" required />
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Qty</label>
                    <div class="col-sm-9">
                        <input asp-for="Qty" class="form-control" placeholder="Enter Qty" required />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Price</label>
                    <div class="col-sm-9">
                        <input asp-for="OPrice" class="form-control" placeholder="Enter Qty" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mr-2">Submit</button>
            </form>
        </div>
    </div>
</div>