@model be.Models.cheque

@{
    ViewData["Title"] = "Cheque";
    Layout = "~/Views/Shared/home.cshtml";
}
@{
    if(Model.Type == "cus")
    {


        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h1 style="color:black;">Edit Customer Cheque</h1>
                    <br />
                    <form asp-controller="edit" asp-action="cheque">
                        <input type="hidden" asp-for="Ch_Id" />
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Customer</label>
                            <div class="col-sm-9">
                                <select asp-for="CName" class="form-control" required>
                                    @{
                                        BentContext db = new BentContext();
                                        var x = db.Customers.ToList();
                                        foreach (var item in x)
                                        {
                                            <option value="@item.CId">@item.CName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Amount</label>
                            <div class="col-sm-9">
                                <input asp-for="Amount" class="form-control" placeholder="Enter Amount" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Cheque's Bank</label>
                            <div class="col-sm-9">
                                <select asp-for="Cheque_of" class="form-control" placeholder="Enter Bank" required>
                                    <option>Meezan</option>
                                    <option>Alfalah</option>
                                    <option>MCB</option>
                                    <option>Askari</option>
                                    <option>Bank Islami</option>
                                    <option>Habib Metro</option>
                                    <option>Faisal Bank</option>
                                    <option>Bank AL Habib</option>
                                    <option>HBL</option>
                                    <option>UBL</option>
                                    <option>JS</option>
                                    <option>Standard Chartard</option>
                                    <option>AL Barka</option>
                                    <option>Citi Bank</option>
                                    <option>Allied Bank</option>
                                    <option>BOP</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Transfer Type</label>
                            <div class="col-sm-9">
                                <select asp-for="Transfer_to" class="form-control" required>
                                    <option value="0">Cash</option>
                                    @{
                                        BentContext db1 = new BentContext();
                                        var x1 = db1.Bankstatements.ToList();
                                        foreach (var item in x1)
                                        {
                                            <option value="@item.BsId">@item.Bankname</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Entry Date</label>
                            <div class="col-sm-9">
                                <input type="date" value="@ViewBag.date" name="edate" class="form-control" placeholder="Enter Date" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit PDC Date</label>
                            <div class="col-sm-9">
                                <input type="date" value="@ViewBag.date1" name="date" class="form-control" placeholder="Enter Date" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Description</label>
                            <div class="col-sm-9">
                                <input asp-for="Description" class="form-control" placeholder="Enter Description" />
                            </div>
                        </div>
                        @{
                            if (TempData.ContainsKey("data"))
                            {
                                <span class="text-danger">@TempData["data"]</span>
                            }
                        }
                        <br />
                        <div class="form-group">
                            <input type="submit" value="Submit" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>

    }
    else
    {


        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h1 style="color:black;">Edit Vendor Cheque</h1>
                    <br />
                    <form asp-controller="edit" asp-action="cheque">
                        <input type="hidden" asp-for="Ch_Id" />
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Customer</label>
                            <div class="col-sm-9">
                                <select asp-for="CName" class="form-control" required>
                                    @{
                                        BentContext db = new BentContext();
                                        var x = db.Venders.ToList();
                                        foreach (var item in x)
                                        {
                                            <option value="@item.VId">@item.VName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Amount</label>
                            <div class="col-sm-9">
                                <input asp-for="Amount" class="form-control" placeholder="Enter Amount" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit Cheque's Bank</label>
                            <div class="col-sm-9">
                                <select asp-for="Cheque_of" class="form-control" asp-items="@ViewBag.BId"></select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Cheque's Bank</label>
                            <div class="col-sm-9">
                                <select asp-for="Transfer_to" class="form-control" placeholder="Enter Bank" required>
                                    <option>Meezan</option>
                                    <option>Alfalah</option>
                                    <option>MCB</option>
                                    <option>Askari</option>
                                    <option>Bank Islami</option>
                                    <option>Habib Metro</option>
                                    <option>Faisal Bank</option>
                                    <option>Bank AL Habib</option>
                                    <option>HBL</option>
                                    <option>UBL</option>
                                    <option>JS</option>
                                    <option>Standard Chartard</option>
                                    <option>AL Barka</option>
                                    <option>Citi Bank</option>
                                    <option>Allied Bank</option>
                                    <option>BOP</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Edit PDC Date</label>
                            <div class="col-sm-9">
                                <input type="date" name="date" class="form-control" placeholder="Enter Date" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Description</label>
                            <div class="col-sm-9">
                                <input asp-for="Description" class="form-control" placeholder="Enter Description" />
                            </div>
                        </div>
                        @{
                            if (TempData.ContainsKey("data"))
                            {
                                <span class="text-danger">@TempData["data"]</span>
                            }
                        }
                        <br />
                        <div class="form-group">
                            <input type="submit" value="Submit" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>

    }
}