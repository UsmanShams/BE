@model be.Models.Followup

@{
    ViewData["Title"] = "followup";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Update Follow Up</h4>
            <form class="forms-sample" asp-controller="edit" asp-action="followup">
                <input type="hidden" asp-for="FuId" />
                <div class="form-group row">
                    <label for="exampleInputEmail2" class="col-sm-3 col-form-label">Customer Name</label>
                    <div class="col-sm-9">
                        <input asp-for="CName" class="form-control" placeholder="Enter Customer Name" required/>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputMobile" class="col-sm-3 col-form-label">Date</label>
                    <div class="col-sm-9">
                        <input asp-for="FuDate" type="date" class="form-control" placeholder="Enter Date" required/>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputPassword2" class="col-sm-3 col-form-label">Description</label>
                    <div class="col-sm-9">
                        <input asp-for="FuDescription" class="form-control" placeholder="Enter Description" required/>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Entered By</label>
                    <div class="col-sm-9">
                        <input asp-for="FuEntered" class="form-control" placeholder="Entered By" required/>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mr-2">Submit</button>
            </form>
        </div>
    </div>
</div>