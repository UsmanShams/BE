@model be.Models.looseledger
@{
    ViewData["Title"] = "po";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Edit Loose Detail</h4>
            <form class="forms-sample" asp-controller="edit" asp-action="loose_det">
                @{
                    if (TempData.ContainsKey("mess"))
                    {
                        <span class="text-danger">@TempData["mess"]</span>
                    }
                }

                <input name="loose_id" type="hidden" value="@ViewBag.loose_id" class="form-control" required></input>
                <div class="form-group row">
                    <label for="exampleInputEmail2" class="col-sm-3 col-form-label">Change Qty</label>
                    <div class="col-sm-9">
                        <input asp-for="lOut" name="qty" class="form-control" required></input>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mr-2" asp-route-id="@ViewBag.id">Add</button>
            </form>
        </div>
    </div>
</div>