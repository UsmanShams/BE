@{
    ViewData["Title"] = "po";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h1>Search Product</h1>
            <form class="forms-sample" asp-controller="front" asp-action="pending">
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Search Customer</label>
                    <div class="col-sm-9">
                        <select name="cid" class="form-control">
                            <option value="0">All</option>
                            @{
                                BentContext db = new BentContext();
                                var res1 = db.Customers.Where(x=>x.CStatus == "Active").OrderBy(x=>x.CName).ToList();
                                foreach (var item in res1)
                                {
                                    <option value="@item.CId">@item.CName</option>
                                }
                            }
                        </select>
                        </div>
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Search Product</label>

                        <div class="col-sm-9">
                            <select name="pid" class="form-control">
                            <option value="0">All</option>
                            @{
                                var res = db.Products.ToList();
                                foreach (var item in res)
                                {
                                    <option value="@item.PId">@item.PName</option>
                                }
                            }
                        </select>
                    </div>
                    @{
                        if (TempData.ContainsKey("cust"))
                        {
                            <span class="text-danger">@TempData["cust"]</span>
                        }
                    }
                </div>
                <button type="submit" class="btn btn-primary mr-2">Search Customer</button>
            </form>
        </div>
    </div>
</div>
