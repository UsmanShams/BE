@model be.Models.Order

@{
    ViewData["Title"] = "ss";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Add Delivered Qty</h4>
            <form class="forms-sample" asp-controller="add" asp-action="ss1">
                @{
                    if (TempData.ContainsKey("mess"))
                    {
                        <span class="text-danger">@TempData["mess"]</span>
                    }
                }
                <input type="hidden" name="id" asp-for="OId" />
                <div class="form-group row">
                    <label for="exampleInputEmail2" class="col-sm-3 col-form-label">Enter Delivered Qty</label>
                    <div class="col-sm-9">
                        <input name="qty" value="@ViewBag.qty" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mr-2">Submit</button>
            </form>
        </div>
    </div>
</div>