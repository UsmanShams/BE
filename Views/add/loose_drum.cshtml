@{
    ViewData["Title"] = "po";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h1 style="color:black;">Open Product</h1>
            <br />
            <form class="forms-sample" asp-controller="add" asp-action="loose_drum">
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Select Product</label>
                    <div class="col-sm-9">
                        <select name="id" class="form-control">
                            @{
                                BentContext db = new BentContext();
                                var res = db.Products.ToList();
                                foreach (var item in res)
                                {
                                    <option value="@item.PId">@item.PName</option>
                                }
                            }
                        </select>
                    </div>
                    @{
                        if (TempData.ContainsKey("cust"))
                        {
                            <span class="text-danger">@TempData["cust"]</span>
                        }
                    }
                </div>
                <button type="submit" class="btn btn-primary mr-2">Open Drum</button>
            </form>
        </div>
    </div>
</div>
