@{
    ViewData["Title"] = "po";
    Layout = "~/Views/Shared/home.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h1 style="color:black;">Order Loose</h1>
            <br />
            <form class="forms-sample" asp-controller="add" asp-action="loose_order">
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Selected Product</label>
                    <div class="col-sm-9">
                        <select name="id" class="form-control">
                              <option value="@ViewBag.id">@ViewBag.name</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="exampleInputEmail2" class="col-sm-3 col-form-label">Enter Customer</label>
                    <div class="col-sm-9">
                        <select name="cus" class="form-control" asp-items="@ViewBag.Cid"></select>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Qty</label>
                    <div class="col-sm-9">
                        <input name="qty" class="form-control" required/>
                    </div>
                    @{
                        if (TempData.ContainsKey("cust"))
                        {
                            <span class="text-danger">@TempData["cust"]</span>
                        }
                    }
                </div>
                <button type="submit" class="btn btn-primary mr-2">Order</button>
            </form>
        </div>
    </div>
</div>
