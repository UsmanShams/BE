@model be.Models.cheque

@{
    ViewData["Title"] = "Cheque";
    Layout = "~/Views/Shared/home.cshtml";
}

@{

    BentContext db = new BentContext();
    var chk = db.pay_type.OrderBy(x => x.PaId).Last();
    var vendor = db.Venders.ToList();
    var cus = db.Customers.Where(x => x.CStatus == "Active").OrderBy(x => x.CName).ToList();
    var bank = db.Bankstatements.ToList();
}
<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            @{
                if(chk.PayerType == "Cus")
                {
                    <h1 style="color:black;">Add Customer Cheque</h1>
                }
                else
                {
                    <h1 style="color:black;">Add Vendor Cheque</h1>
                }
            }
            <br />
            <form asp-controller="add" asp-action="cheque">
                @{
                    if (TempData.ContainsKey("data"))
                    {
                        <span class="text-danger">@TempData["data"]</span>
                    }
                }
                @{
                    if (chk.PayerType == "Pet")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Select Vendor</label>
                            <div class="col-sm-9">
                                <select name="vid" class="form-control">
                                    @{
                                        foreach (var item in vendor)
                                        {
                                            <option class="form-control" value="@item.VId">@item.VName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else if (chk.PayerType == "Cus")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Select Customer</label>
                            <div class="col-sm-9">
                                <select name="iid" class="form-control">
                                    @{
                                        foreach (var item in cus)
                                        {
                                            <option class="form-control" value="@item.CId">@item.CName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                           
                    }
                }
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Amount</label>
                    <div class="col-sm-9">
                        <input asp-for="Amount" class="form-control" placeholder="Enter Amount" />
                    </div>
                </div>
                @{
                    if(chk.PayerType == "Cus")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Cheque's Bank</label>
                            <div class="col-sm-9">
                                <select asp-for="Cheque_of" class="form-control" placeholder="Enter Bank" required>
                                    <option>Meezan</option>
                                    <option>Alfalah</option>
                                    <option>MCB</option>
                                    <option>Askari</option>
                                    <option>Bank Islami</option>
                                    <option>Habib Metro</option>
                                    <option>Faisal Bank</option>
                                    <option>Bank AL Habib</option>
                                    <option>HBL</option>
                                    <option>UBL</option>
                                    <option>JS</option>
                                    <option>Standard Chartard</option>
                                    <option>AL Barka</option>
                                    <option>Citi Bank</option>
                                    <option>Allied Bank</option>
                                    <option>BOP</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if(chk.PayerType == "Pet")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Select Cheque's Bank</label>
                            <div class="col-sm-9">
                                <select asp-for="Cheque_of" class="form-control" placeholder="Enter Bank" required>
                                    @{
                                        var ba = db.Bankstatements.ToList();
                                        foreach (var item in ba)
                                        {
                                            <option class="form-control" value="@item.Bankname">@item.Bankname</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                }
                
                @{
                    if (chk.PayerType == "Cus")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Transfer Type</label>
                            <div class="col-sm-9">
                                <select asp-for="Transfer_to" class="form-control" required>
                                    <option value="0">Cash</option>
                                    @{
                                        BentContext db1 = new BentContext();
                                        var x1 = db1.Bankstatements.ToList();
                                        foreach (var item in x1)
                                        {
                                            <option value="@item.BsId">@item.Bankname</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else if (chk.PayerType == "Pet")
                    {
                        <div class="form-group row">
                            <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Transfer Type</label>
                            <div class="col-sm-9">
                                <select asp-for="Transfer_to" class="form-control" placeholder="Enter Bank" required>
                                    <option>Meezan</option>
                                    <option>Alfalah</option>
                                    <option>MCB</option>
                                    <option>Askari</option>
                                    <option>Bank Islami</option>
                                    <option>Habib Metro</option>
                                    <option>Faisal Bank</option>
                                    <option>Bank AL Habib</option>
                                    <option>HBL</option>
                                    <option>UBL</option>
                                    <option>JS</option>
                                    <option>Standard Chartard</option>
                                    <option>AL Barka</option>
                                    <option>Citi Bank</option>
                                    <option>Allied Bank</option>
                                    <option>BOP</option>
                                </select>
                            </div>
                        </div>
                    }
                }
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter PDC Date</label>
                    <div class="col-sm-9">
                        <input type="date" name="date" class="form-control" placeholder="Enter Date" required />
                    </div>
                </div>
                <div class="form-group row">
                    <label for="exampleInputConfirmPassword2" class="col-sm-3 col-form-label">Enter Description</label>
                    <div class="col-sm-9">
                        <input asp-for="Description" class="form-control" placeholder="Enter Description" />
                    </div>
                </div>
                
                <br />
                <div class="form-group">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>
